# Copy to .env.local (gitignored) and adjust if your setup differs from the
# defaults. Every var here is read server-side only (src/lib/providers/).

# Base URL for the local Ollama instance that runs Hermes and other local
# models. Default matches Ollama's own default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Command used to check for the Claude Code CLI (`<bin> --version`). Only
# needs to change if `claude` isn't the right binary name/path on your PATH.
CLAUDE_CODE_BIN=claude
